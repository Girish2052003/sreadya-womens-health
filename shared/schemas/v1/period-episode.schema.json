{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sreadya.local/v1/period-episode.schema.json",
  "title": "Sreadya PeriodEpisode v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "start", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Canonical transport timestamp encoded as UTC RFC3339."
    },
    "end": {
      "anyOf": [
        {"type": "string", "format": "date-time", "pattern": "Z$"},
        {"type": "null"}
      ],
      "description": "Optional inclusive episode end transported as UTC RFC3339; null while the episode is open."
    },
    "source": {
      "type": "string",
      "enum": ["app", "healthKit", "healthConnect", "cycleVault"]
    },
    "externalId": {"type": ["string", "null"]}
  }
}
