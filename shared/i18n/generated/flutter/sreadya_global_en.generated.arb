  "sreadya_publicTopic__dot__about__dot__section3__dot__title": "Health boundaries",
  "sreadya_publicTopic__dot__accessibility__dot__intro": "Sreadya provides light/dark presentation, text scaling, reduced motion, high contrast, keyboard/screen-reader semantics, easy-language guidance and locale/RTL formatting infrastructure.",
