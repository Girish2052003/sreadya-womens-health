  "sreadya_publicTopic__dot__about__dot__section2__dot__action": "Continue without account",
  "sreadya_publicTopic__dot__about__dot__section2__dot__body": "Core tracking, logging, predictions, insights, reminders, reports, privacy and local vault features do not require an account.",
